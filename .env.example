# Copy to .env (which is gitignored) and fill in.
# Used by the migration script in Phase A and the build script in Phase B.

SANITY_PROJECT_ID=
SANITY_DATASET=production

# Production origin, no trailing slash, e.g. https://govind-reisen.de
# Only set this for the production deployment. Leaving it unset on previews is
# correct: it suppresses the canonical tag and sitemap, so a preview cannot tell
# Google it is the real site.
SITE_URL=

# Editor token from sanity.io/manage -> API -> Tokens.
# Write access. Never commit this, never put it in browser-side code.
SANITY_WRITE_TOKEN=
